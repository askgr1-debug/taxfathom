# Cloudflare Workers static assets reads this file as config (verified: a
# request for /_headers itself 404s, and these Cache-Control values show up
# on the live responses).
#
# Strategy: hashed build assets are immutable; everything else is left on the
# Workers default (max-age=0, must-revalidate) so the edge revalidates against
# the origin ETag and a redeploy is picked up without a manual purge. The OG
# card and favicon are the exception — they change rarely, so a short cache is
# worth the small staleness window.

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/og-default.png
  Cache-Control: public, max-age=3600, must-revalidate

/favicon.svg
  Cache-Control: public, max-age=3600, must-revalidate
